{
    "name": "toporia/toporia",
    "description": "Toporia - A modern PHP application built with Clean Architecture",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Phungtruong7820",
            "email": "minhphung485@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "toporia/framework": "^1.0@dev",
        "phpmailer/phpmailer": "^7.0",
        "aws/aws-sdk-php": "^3.359",
        "php-amqplib/php-amqplib": "^3.0",
        "nmred/kafka-php": "^0.2.0",
        "elasticsearch/elasticsearch": "^8.13",
        "phpoffice/phpspreadsheet": "^5.2",
        "openspout/openspout": "^4.28",
        "mongodb/mongodb": "^0.2.0"
    },
    "require-dev": {
        "jetbrains/phpstorm-stubs": "*",
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.24"
    },
    "suggest": {
        "mongodb/mongodb": "Required for MongoDB support (toporia/mongodb package)",
        "ext-mongodb": "Required for MongoDB PHP extension",
        "ext-redis": "Required for Redis Pub/Sub broker and cache driver",
        "ext-rdkafka": "Required for high-performance Kafka broker",
        "ext-pdo_mysql": "Required for MySQL database support",
        "ext-pdo_pgsql": "Required for PostgreSQL database support",
        "ext-pcntl": "Required for multi-process execution (Linux/macOS)",
        "ext-zip": "Required for Excel import/export"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/framework"
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:unit": "vendor/bin/phpunit --testsuite Unit",
        "test:feature": "vendor/bin/phpunit --testsuite Feature",
        "test:integration": "vendor/bin/phpunit --testsuite Integration",
        "test:performance": "vendor/bin/phpunit --testsuite Performance",
        "test:coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
